# SukiSU Nova Built-in prerequisites for the merlin ARM64 test profile.
# Keep this isolated from the general MT6768 defconfig.
CONFIG_SYSFS=y
CONFIG_MULTIUSER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_AUDIT=y
CONFIG_SECURITY_SELINUX=y

CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_INLINE_HOOK=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
